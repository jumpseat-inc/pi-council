node_modules/

# macOS
.DS_Store

# pi harness + transient hub state
.pi/git/
.pi/council/.pids.json
.pi/council/gate-ledger.jsonl
# Smoke test run artifacts (dot-dir so bun test never discovers them)
smoke/.artifacts/*
!smoke/.artifacts/.gitkeep

# git worktrees (superpowers isolation)
.worktrees/

# Python bytecode — council/validate.py is run in place by devs and by the
# gates workflow, so __pycache__/ can appear under council/. Regenerable
# bytecode must never be committed (and council/.gitattributes assumes all
# files under council/ are text).
__pycache__/
*.py[cod]

